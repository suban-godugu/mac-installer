# Optional: seeds the encrypted key store on first launch. Keys are moved into
# OS-protected storage (Windows DPAPI via Electron safeStorage) and can then be
# removed from this file. Model names are free-form OpenRouter model ids.
OPENROUTER_CONTROLLER_API_KEY=
OPENROUTER_CONTROLLER_MODEL=
OPENROUTER_RESEARCH_API_KEY=
OPENROUTER_RESEARCH_MODEL=
